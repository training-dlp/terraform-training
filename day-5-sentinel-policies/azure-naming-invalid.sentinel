import "strings"

# Test data with INVALID names - should fail the policy
resources = [
    {
        "name": "myResourceGroup",
        "type": "azurerm_resource_group",
    },
    {
        "name": "resource-group-1",
        "type": "azurerm_resource_group",
    },
    {
        "name": "Production-RG-01",
        "type": "azurerm_resource_group",
    },
    {
        "name": "prod-rg-webapp-01",  # This one is valid
        "type": "azurerm_resource_group",
    },
]

# Naming convention pattern: <env>-<type>-<app>-<num>
naming_pattern = "^(dev|test|stage|prod)-[a-z0-9]+-[a-z0-9]+-[0-9]{2}$"

# Validate each resource
print("=== Azure Resource Naming Convention Validation ===")
print("")

passed = 0
failed = 0

for resources as resource {
    if resource.name matches naming_pattern and length(resource.name) <= 63 {
        print("✓ PASS:", resource.name, "-", resource.type)
        passed = passed + 1
    } else {
        print("✗ FAIL:", resource.name, "-", resource.type)
        if not (resource.name matches naming_pattern) {
            print("  Reason: Does not match naming pattern <env>-<type>-<app>-<num>")
        }
        if length(resource.name) > 63 {
            print("  Reason: Name too long (max 63 characters)")
        }
        failed = failed + 1
    }
}

print("")
print("Summary:", passed, "passed,", failed, "failed")
print("")

# Main rule - all resources must pass
main = rule {
    all resources as resource {
        resource.name matches naming_pattern and
        length(resource.name) <= 63
    }
}

